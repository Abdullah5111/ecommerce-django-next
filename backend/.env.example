SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=postgres
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=ecommerce
DB_HOST=db
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=ecommerce-cache

FRONTEND_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Stripe (test mode). Leave STRIPE_SECRET_KEY blank to run checkout in mock
# mode — no SDK calls, no keys required. Set all three to enable real payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Web Push (VAPID). Leave blank to disable browser push — in-app notifications
# and emails still work. Generate a keypair with: python -m py_vapid --gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# Google Sign-In. Leave blank to disable (the button hides). This is the OAuth
# 2.0 Client ID from the Google Cloud console; the frontend reads it from the API.
GOOGLE_OAUTH_CLIENT_ID=
