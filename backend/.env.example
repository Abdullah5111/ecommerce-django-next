SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=postgres
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=ecommerce
DB_HOST=db
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Refresh-token cookie. SameSite=Lax needs the storefront and API on one site;
# see docs/DEPLOYMENT.md, "Sign-in cookie". The Secure flag defaults to on
# whenever DEBUG is off; leave it unset (a blank value would mean false).
# AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax

# Redis for the cache (throttles, phone codes, catalog) and WebSocket fan-out.
# Blank = per-process LocMem cache + InMemory channel layer (dev/tests); set to
# e.g. redis://redis:6379/0 for multi-process/multi-instance deploys
# (docker-compose sets it). The cache uses database REDIS_CACHE_DB (default 1)
# and the channel layer REDIS_CHANNELS_DB (default 0) on that server.
REDIS_URL=
# REDIS_CACHE_DB=1
# REDIS_CHANNELS_DB=0
# Seconds before an unreachable Redis fails a request instead of hanging it.
# The read timeout applies to the cache only (the channel layer blocks on
# purpose while waiting for messages).
# REDIS_CONNECT_TIMEOUT=0.5
# REDIS_SOCKET_TIMEOUT=1.0
# Messages queued per WebSocket before overflow is dropped (default 1000).
# CHANNEL_LAYER_CAPACITY=1000

# Manual cache override. Leave unset: when set, these win over REDIS_URL.
# CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
# CACHE_LOCATION=ecommerce-cache

# Celery broker (RabbitMQ), e.g. amqp://user:pass@rabbitmq:5672//. Blank runs
# background tasks inline, so local dev and tests need no broker.
CELERY_BROKER_URL=

FRONTEND_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Stripe (test mode). Leave STRIPE_SECRET_KEY blank to run checkout in mock
# mode — no SDK calls, no keys required. Set all three to enable real payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Keyless mock checkout (no real charge). Defaults to DEBUG; set it explicitly
# for a keyless demo deploy running with DEBUG=False.
PAYMENTS_MOCK=

# Phone verification SMS. "console" prints codes (dev only), "twilio" sends
# real texts. Unset outside DEBUG means phone verification returns 503.
SMS_BACKEND=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of these two; a Messaging Service wins if both are set.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Web Push (VAPID). Leave blank to disable browser push — in-app notifications
# and emails still work. Generate a keypair with: python -m py_vapid --gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# Google Sign-In. Leave blank to disable (the button hides). This is the OAuth
# 2.0 Client ID from the Google Cloud console; the frontend reads it from the API.
GOOGLE_OAUTH_CLIENT_ID=

# Sales tax as a percent of discounted merchandise (e.g. 8.25 for 8.25%).
# Leave at 0 to omit the tax line entirely.
TAX_RATE=0

# Media storage for uploads (avatars, review photos). Leave blank to use local
# disk, which is fine for local dev. REQUIRED on Cloud Run: its filesystem is
# ephemeral and per-instance, so without a bucket uploads are lost on redeploy
# and invisible to other instances. Auth comes from the runtime service account.
GS_BUCKET_NAME=
